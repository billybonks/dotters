[alias]
	s = status
	lo = log --pretty=oneline
	lb = branch --sort=committerdate
	ub = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }'
	co = checkout
	cb = checkout -b
	ri = rebase -i
	trash = reset head --hard
	graph = log --graph --pretty=\"format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)\"
	bda = !git branch --no-color --merged | grep -vE \"^([+*]|\\s*(main|master|develop)\\s*$)\" | xargs git branch --delete 2>/dev/null
[rebase]
    autoSquash = true
[push]
    autoSetupRemote = true
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
